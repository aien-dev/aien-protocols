# tests/gates/proto-fmt.gate
# Mirrors hosted step: ci.yml 'Verify Code Formatting': cargo fmt --all -- --check
gate: PROTO-FMT
manifest_version: 2
owner: aien-protocols
requires:
  - portable
inputs:
  - Cargo.toml
  - Cargo.lock
  - crates/
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["fmt"]
expects:
  exit: 0
  verdict: PASS
timeout: 5m
exactness: EXACT
cache_scope: portable
