# tests/gates/crumb.gate
# Mirrors: crumb verify . (ADR 0033 D11; always-run). Inputs cannot list every nested
# .crumb (manifests take literal paths, not globs), so results are never cached.
gate: CRUMB-VERIFY
manifest_version: 2
owner: aien-protocols
requires:
  - portable
inputs:
  - .crumb
run:
  exec: tests/gates/run.sh
  args: ["crumb-verify"]
expects:
  exit: 0
  verdict: PASS
timeout: 2m
exactness: EXACT
cache_scope: portable
cache: never
