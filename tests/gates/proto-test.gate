# tests/gates/proto-test.gate
# Mirrors hosted step: ci.yml 'Run Workspace Unit and Integration Tests': cargo test --workspace --verbose (hosted job 58 s total)
gate: PROTO-TEST
manifest_version: 2
owner: aien-protocols
requires:
  - host
inputs:
  - Cargo.toml
  - Cargo.lock
  - crates/
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["test"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine
