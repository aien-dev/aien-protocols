# tests/gates/proto-zero-disk-secrets.gate
# Mirrors hosted step: ci.yml 'Enforce Zero Disk Secrets Invariant' (always-run)
gate: PROTO-ZERO-DISK-SECRETS
manifest_version: 2
owner: aien-protocols
requires:
  - portable
inputs:
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["zero-disk-secrets"]
expects:
  exit: 0
  observe: ["env_files_found == false"]
  verdict: PASS
timeout: 2m
exactness: EXACT
cache_scope: portable
